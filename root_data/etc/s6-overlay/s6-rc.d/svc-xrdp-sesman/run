#! /usr/bin/execlineb -P

# Redirect stderr to stdout.
fdmove -c 2 1

# Notify service manager when xrdp-sesman is up (use ::1 instead of localhost
# since xrdp-sesman binds to IPv6 only; "localhost" resolves to 127.0.0.1
# under network_mode:host with systemd-resolved, causing the check to fail)
s6-notifyoncheck -w 500 -c "nc -z ::1 3350"

/usr/sbin/xrdp-sesman --nodaemon
